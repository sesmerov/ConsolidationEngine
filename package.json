{
  "name": "consolidation-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "generate:parser": "node scripts/generate-parser.mjs",
    "fixtures": "node scripts/create-fixtures.mjs",
    "prepare:templates": "node scripts/prepare-visual-templates.mjs",
    "prepare:demos": "node scripts/create-visual-demos.mjs",
    "build:packages": "npm run build --workspace @ce/contracts && npm run build --workspace @ce/engine",
    "build:api": "npm run build:packages && npm run build --workspace @ce/api",
    "build": "npm run generate:parser && npm run build:api && npm run build --workspace @ce/web",
    "package:vercel:web": "node scripts/package-vercel-web.mjs",
    "package:vercel:api": "node scripts/package-vercel-api.mjs",
    "test:package:linux": "node scripts/test-package-linux.mjs",
    "test:capacity:hosted": "node scripts/test-capacity-hosted.mjs",
    "typecheck": "npm run build:packages && npm run typecheck --workspace @ce/api && npm run typecheck --workspace @ce/web",
    "test:unit": "vitest run --project engine && npm run test --workspace @ce/web -- --watch=false",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:hosted": "node scripts/test-hosted.mjs",
    "test:foundation": "npm run build:api && vitest run --project integration --project contract tests/integration/session-jobs.spec.ts tests/contract/local-session.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "node scripts/test-e2e-hosted.mjs",
    "bench": "node scripts/benchmark.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract",
    "dev": "npm run build:api && node scripts/dev.mjs",
    "start": "node apps/api/dist/server.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/sax": "1.2.7",
    "@types/yauzl": "3.4.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@vercel/oidc": {
      "@vercel/cli-config": {
        ".": "0.3.6",
        "zod": "4.6.6"
      }
    },
    "@fastify/static": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.1"
      }
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
